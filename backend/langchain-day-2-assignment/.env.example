# Choose one provider: company, ollama, openai, or gemini
LLM_PROVIDER=company

# Company-hosted OpenAI-compatible server settings.
# Replace placeholders locally in .env. Do not commit .env.
COMPANY_BASE_URL=https://your-company-model-server/v1
COMPANY_MODEL=llama3.1:8b
COMPANY_USERNAME=your_username
COMPANY_PASSWORD=your_password
COMPANY_VERIFY_SSL=false
COMPANY_TIMEOUT=300

# Local Ollama settings, only needed when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI settings, only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini settings, only needed when LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Set to true only when you want Assignment 1 thoughts generated by the LLM.
USE_LLM_REASONING=false

# Used by Assignment 4 for approximate cost display when provider does not return billing metadata.
COST_PER_1000_TOKENS=0
