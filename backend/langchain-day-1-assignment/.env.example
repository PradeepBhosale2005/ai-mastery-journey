# Choose one provider: ollama, openai, or gemini
LLM_PROVIDER=ollama

# Local Ollama settings. Install Ollama and run: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI settings, only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini settings, only needed when LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Used by Assignment 4 for non-OpenAI providers. Local Ollama cost is normally 0.
COST_PER_1000_TOKENS=0
