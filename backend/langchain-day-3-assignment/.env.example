# Choose one provider: company, ollama, openai, or gemini
# Default scripts run without live LLM calls unless USE_LIVE_LLM=true.
LLM_PROVIDER=company
USE_LIVE_LLM=false

# Company-hosted OpenAI-compatible server settings.
# Replace these locally in .env. Do not commit .env.
COMPANY_BASE_URL=https://your-company-model-server/v1
COMPANY_MODEL=llama3.1:8b
COMPANY_USERNAME=your_username
COMPANY_PASSWORD=your_password
COMPANY_VERIFY_SSL=false
COMPANY_TIMEOUT=300

# Local Ollama settings, only needed when LLM_PROVIDER=ollama and USE_LIVE_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI settings, only needed when LLM_PROVIDER=openai and USE_LIVE_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini settings, only needed when LLM_PROVIDER=gemini and USE_LIVE_LLM=true
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
