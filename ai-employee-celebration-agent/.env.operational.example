# Operational AI Employee Celebration Agent configuration
# Copy to .env and fill locally. Never commit .env.

# Workday RaaS report
WORKDAY_RAAS_URL=
WORKDAY_USERNAME=
WORKDAY_PASSWORD=
WORKDAY_ACCESS_TOKEN=
WORKDAY_VERIFY_SSL=true
WORKDAY_TIMEOUT_SECONDS=60
DEFAULT_EMPLOYEE_TIMEZONE=UTC

# Message generation. Keep mock until delivery is stable.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=llama3.1:8b
LLM_USERNAME=
LLM_PASSWORD=
LLM_VERIFY_SSL=false
LLM_TIMEOUT_SECONDS=60

# SMTP email delivery
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Celebration Agent
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Use this for testing so real employee emails are not used.
SMTP_TO_OVERRIDE=
SMTP_CC_LIST=
SMTP_CC_MANAGER=false

# Generic API posting. Can be any webhook/API endpoint that accepts JSON.
POST_TARGET_API_ENABLED=false
POST_TARGET_API_URL=
POST_TARGET_API_METHOD=POST
POST_TARGET_API_BEARER_TOKEN=
POST_TARGET_API_HEADERS_JSON={}
POST_TARGET_API_TIMEOUT_SECONDS=30
