# Default is mock, so no external LLM credentials are required for demo.
LLM_PROVIDER=mock

# Optional OpenAI-compatible/company LLM configuration.
# Never commit real passwords or tokens.
LLM_BASE_URL=https://aimodels.example.com/v1
LLM_MODEL=llama3.1:8b
LLM_USERNAME=
LLM_PASSWORD=
LLM_VERIFY_SSL=false
LLM_TIMEOUT_SECONDS=60

# Agent defaults
DEFAULT_DATA_PATH=data/mock_workday_employees.json
DEFAULT_OUTBOX_PATH=outbox/notifications.jsonl
DEFAULT_AUDIT_LOG_PATH=audit_logs/agent_audit.jsonl
