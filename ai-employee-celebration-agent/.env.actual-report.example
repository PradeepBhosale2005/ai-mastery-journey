# Exact Workday RaaS report configuration for RPT_AI_Employee_Celebration_Agent
# Copy this file to .env and fill values locally.
# Never commit .env or real credentials.

# Paste your real RaaS JSON URL locally in .env.
# Example:
# WORKDAY_RAAS_URL=https://impl-services1.wd12.myworkday.com/ccx/service/customreport2/<tenant>/<isu>/RPT_AI_Employee_Celebration_Agent?format=json
WORKDAY_RAAS_URL=

# Basic Auth using the ISU that can run the report.
WORKDAY_USERNAME=
WORKDAY_PASSWORD=

# Optional bearer token. If supplied, token auth is used instead of Basic Auth.
WORKDAY_ACCESS_TOKEN=

WORKDAY_VERIFY_SSL=true
WORKDAY_TIMEOUT_SECONDS=60
DEFAULT_EMPLOYEE_TIMEZONE=UTC

# Keep mock mode first until Workday data fetch is working.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=llama3.1:8b
LLM_USERNAME=
LLM_PASSWORD=
LLM_VERIFY_SSL=false
LLM_TIMEOUT_SECONDS=60
