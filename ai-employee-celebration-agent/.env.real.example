# Real Workday RaaS integration settings
# Copy this file to .env and fill values locally.
# Never commit .env or real credentials.

# Workday custom report exposed as RaaS JSON.
# Example shape only. Replace tenant, user/report path, and query params with your real report URL.
WORKDAY_RAAS_URL=https://wd2-impl-services1.workday.com/ccx/service/customreport2/YOUR_TENANT/YOUR_ISU/YOUR_REPORT_NAME?format=json

# Auth option 1: Basic authentication using an ISU.
WORKDAY_USERNAME=
WORKDAY_PASSWORD=

# Auth option 2: Bearer token. If this is supplied, it is used instead of Basic Auth.
WORKDAY_ACCESS_TOKEN=

# SSL and timeout.
WORKDAY_VERIFY_SSL=true
WORKDAY_TIMEOUT_SECONDS=60

# Optional query params passed to the RaaS endpoint.
# Keep as JSON object. Example: {"As_Of_Date":"2026-08-30"}
WORKDAY_QUERY_PARAMS_JSON={}

# Optional custom mapping when your Workday report column names are different.
# Keys must be the normalized fields used by this app.
WORKDAY_FIELD_MAP_JSON={
  "employee_id": ["Employee_ID"],
  "worker_id": ["Worker_ID"],
  "preferred_name": ["Preferred_Name"],
  "legal_name": ["Legal_Name"],
  "email": ["Work_Email"],
  "manager_email": ["Manager_Email"],
  "date_of_birth": ["Date_of_Birth"],
  "hire_date": ["Hire_Date"],
  "timezone": ["Time_Zone"],
  "country": ["Country"],
  "department": ["Department"],
  "status": ["Worker_Status"],
  "celebration_channel": ["Celebration_Channel"]
}

# Defaults
DEFAULT_EMPLOYEE_TIMEZONE=UTC
DEFAULT_OUTBOX_PATH=outbox/real_workday_notifications.jsonl
DEFAULT_AUDIT_LOG_PATH=audit_logs/real_workday_agent_audit.jsonl

# LLM can remain mock for first real Workday data test.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=llama3.1:8b
LLM_USERNAME=
LLM_PASSWORD=
LLM_VERIFY_SSL=false
LLM_TIMEOUT_SECONDS=60
